{
    "firestore": {
        "rules": "backend/firestore.rules",
        "indexes": "backend/firestore.indexes.json"
    },
    "storage": {
        "rules": "backend/storage.rules"
    },
    "functions": [
        {
            "source": "backend/cloud_functions",
            "codebase": "default",
            "ignore": [
                "node_modules",
                ".git",
                "firebase-debug.log",
                "firebase-debug.*.log"
            ],
            "predeploy": [],
            "runtime": "nodejs20"
        }
    ],
    "emulators": {
        "auth": {
            "port": 9099
        },
        "functions": {
            "port": 5001
        },
        "firestore": {
            "port": 8080
        },
        "storage": {
            "port": 9199
        },
        "ui": {
            "enabled": true,
            "port": 4000
        },
        "singleProjectMode": true
    }
}